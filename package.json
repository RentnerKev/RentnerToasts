{
    "name": "@rentnerkev/toasts",
    "version": "3.3.2",
    "description": "Accessible, customizable toast notifications for React.",
    "keywords": [
        "react",
        "toast",
        "notifications",
        "typescript",
        "tailwindcss"
    ],
    "author": "RentnerKev",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "tailwind.css",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": [
        "./tailwind.css"
    ],
    "scripts": {
        "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc",
        "typecheck": "tsc --noEmit && bun run typecheck:automation",
        "test": "bun test",
        "test:browser": "playwright test --config=playwright.config.ts",
        "playground:install": "bun install --cwd playground --frozen-lockfile",
        "prepare": "bun run build",
        "pack:check": "bun pm pack --dry-run --ignore-scripts",
        "pack:consumer": "node scripts/consumer/verify.mjs",
        "playground:dev": "bun --cwd playground dev",
        "playground:build": "bun --cwd playground build",
        "lint": "oxlint --deny-warnings src playground/src playground/vite.config.ts scripts playwright.config.ts .github",
        "lint:fix": "oxlint --fix --deny-warnings src playground/src playground/vite.config.ts scripts playwright.config.ts .github",
        "format": "oxfmt src playground/src playground/package.json playground/tsconfig.json playground/vite.config.ts scripts playwright.config.ts package.json tsconfig.json tailwind.css README.md docs .oxfmtrc.json .oxlintrc.json bunfig.toml .github",
        "format:check": "oxfmt --check src playground/src playground/package.json playground/tsconfig.json playground/vite.config.ts scripts playwright.config.ts package.json tsconfig.json tailwind.css README.md docs .oxfmtrc.json .oxlintrc.json bunfig.toml .github",
        "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build",
        "verify": "bun run playground:install && bun run playground:typecheck && bun run check && bun run playground:build && bun run test:browser && bun run pack:check && bun run pack:consumer",
        "typecheck:automation": "tsc --noEmit -p .github/scripts/tsconfig.json",
        "playground:typecheck": "bunx --bun tsc --noEmit -p playground/tsconfig.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RentnerKev/RentnerToasts.git"
    },
    "homepage": "https://packages.rentner.dev/packages/toasts",
    "bugs": {
        "url": "https://github.com/RentnerKev/RentnerToasts/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "peerDependencies": {
        "lucide-react": "^1.0.0",
        "motion": "^12.38.0 || ^13.0.0 || ^14.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "lucide-react": "^1.52.0",
        "motion": "^14.0.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tailwind.css": "./tailwind.css",
        "./toast": {
            "types": "./dist/lib/ToastStore/toastApi.d.ts",
            "import": "./dist/lib/ToastStore/toastApi.js"
        },
        "./messages": {
            "types": "./dist/lib/Messages/toastMessages.d.ts",
            "import": "./dist/lib/Messages/toastMessages.js"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.js"
        },
        "./package.json": "./package.json",
        "./lazy-provider": {
            "types": "./dist/shared/Toast/Components/ToastProvider.d.ts",
            "import": "./dist/shared/Toast/Components/ToastProvider.js"
        }
    },
    "packageManager": "bun@1.4.2"
}
