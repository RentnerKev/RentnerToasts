{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "plugins": [
        "typescript",
        "react",
        "import",
        "unicorn",
        "promise",
        "node",
        "oxc",
        "jsx-a11y"
    ],
    "ignorePatterns": [
        "**/dist/**",
        "**/build/**",
        "**/node_modules/**",
        "**/drizzle/**",
        "**/.env",
        "**/.env.*",
        "**/routeTree.gen.*",
        "**/*.generated.*",
        "**/target/**",
        "test-results/**",
        "playwright-report/**",
        "coverage/**"
    ],
    "rules": {
        "typescript/no-explicit-any": "warn",
        "typescript/no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "react/react-in-jsx-scope": "off",
        "react/no-children-prop": "off",
        "react/jsx-no-useless-fragment": "warn",
        "import/no-cycle": "off",
        "unicorn/filename-case": "off"
    }
}
